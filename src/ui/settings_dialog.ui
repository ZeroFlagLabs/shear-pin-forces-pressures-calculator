     <widget class="QWidget" name="references_tab">
      <attribute name="title">
       <string>References</string>
      </attribute>
      <layout class="QVBoxLayout" name="referencesLayout">
       <item>
        <widget class="QScrollArea" name="references_scroll">
         <property name="widgetResizable">
          <bool>true</bool>
         </property>
         <property name="frameShape">
          <enum>QFrame::Shape::NoFrame</enum>
         </property>
         <widget class="QWidget" name="references_content">
          <layout class="QVBoxLayout" name="referencesContentLayout">
           <property name="leftMargin">
            <number>3</number>
           </property>
           <property name="rightMargin">
            <number>3</number>
           </property>
           <property name="topMargin">
            <number>3</number>
           </property>
           <property name="bottomMargin">
            <number>3</number>
           </property>
           <item><widget class="QLabel" name="references_heading_0"><property name="text"><string>Ultimate shear strength</string></property><property name="styleSheet"><string>font-weight:600; color:#164f8a;</string></property></widget></item><item><widget class="QLabel" name="references_text_0"><property name="textFormat"><enum>Qt::TextFormat::RichText</enum></property><property name="text"><string>&lt;html&gt;&lt;body&gt;&lt;p&gt;Richard T. Barrett, &lt;i&gt;Fastener Design Manual&lt;/i&gt;, NASA Reference Publication 1228, March 1990, p. 21, “Approximate Bearing and Shear Allowables”.&lt;/p&gt;&lt;p&gt;In the absence of material-specific shear data, the manual gives ultimate shear-to-tensile strength ratios of 0.60 for carbon and alloy steels and 0.55 for stainless steels.&lt;/p&gt;&lt;p&gt;&lt;a href="https://ntrs.nasa.gov/citations/19900009424"&gt;NASA Technical Reports Server&lt;/a&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string></property><property name="wordWrap"><bool>true</bool></property><property name="openExternalLinks"><bool>true</bool></property></widget></item>
<item><spacer name="referencesSectionGap1"><property name="orientation"><enum>Qt::Orientation::Vertical</enum></property><property name="sizeType"><enum>QSizePolicy::Fixed</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item><item><widget class="QLabel" name="references_heading_1"><property name="text"><string>Yield criteria</string></property><property name="styleSheet"><string>font-weight:600; color:#164f8a;</string></property></widget></item><item><widget class="QLabel" name="references_text_1"><property name="textFormat"><enum>Qt::TextFormat::RichText</enum></property><property name="text"><string>&lt;html&gt;&lt;body&gt;&lt;p&gt;For pure shear, Tresca predicts yielding at 0.5 × tensile yield strength; von Mises predicts yielding at tensile yield strength / √3 (approximately 0.577). These are yield criteria, not ultimate fracture relationships. The calculator estimates ultimate shear failure rather than onset of yielding.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
<item><spacer name="referencesSectionGap2"><property name="orientation"><enum>Qt::Orientation::Vertical</enum></property><property name="sizeType"><enum>QSizePolicy::Fixed</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item><item><widget class="QLabel" name="references_heading_2"><property name="text"><string>Selection of shear strength factor</string></property><property name="styleSheet"><string>font-weight:600; color:#164f8a;</string></property></widget></item><item><widget class="QLabel" name="references_text_2"><property name="textFormat"><enum>Qt::TextFormat::RichText</enum></property><property name="text"><string>&lt;html&gt;&lt;body&gt;&lt;p&gt;The default is 0.6. Use material-specific ultimate shear data or representative pin test results where available. The factor is an estimate, not a safety factor or proof of a required release-pressure window. A lower factor does not necessarily give a conservative release-pressure prediction.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
           <item>
