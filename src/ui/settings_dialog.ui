           <property name="topMargin">
            <number>3</number>
           </property>
           <property name="bottomMargin">
            <number>3</number>
           </property>
           <item><widget class="QLabel" name="assumptions_heading_0"><property name="text"><string>Scope</string></property><property name="styleSheet"><string>font-weight:600; color:#164f8a;</string></property></widget></item><item><widget class="QLabel" name="assumptions_text_0"><property name="textFormat"><enum>Qt::TextFormat::RichText</enum></property><property name="text"><string>&lt;html&gt;&lt;body&gt;&lt;p&gt;Estimates the minimum and maximum shear failure forces of identical pins and, where annulus dimensions are provided, the corresponding differential pressures.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
<item><spacer name="assumptionsSectionGap1"><property name="orientation"><enum>Qt::Orientation::Vertical</enum></property><property name="sizeType"><enum>QSizePolicy::Fixed</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item><item><widget class="QLabel" name="assumptions_heading_1"><property name="text"><string>Calculation basis</string></property><property name="styleSheet"><string>font-weight:600; color:#164f8a;</string></property></widget></item><item><widget class="QLabel" name="assumptions_text_1"><property name="textFormat"><enum>Qt::TextFormat::RichText</enum></property><property name="text"><string>&lt;html&gt;&lt;body&gt;&lt;p&gt;• Ultimate shear strength is estimated from UTS using the selected shear strength factor.&lt;/p&gt;&lt;p&gt;• Equal load sharing is assumed across all pins and shear planes.&lt;/p&gt;&lt;p&gt;• Minimum and maximum results account for the governing material properties and dimensional limits.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
<item><spacer name="assumptionsSectionGap2"><property name="orientation"><enum>Qt::Orientation::Vertical</enum></property><property name="sizeType"><enum>QSizePolicy::Fixed</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item><item><widget class="QLabel" name="assumptions_heading_2"><property name="text"><string>Interpretation</string></property><property name="styleSheet"><string>font-weight:600; color:#164f8a;</string></property></widget></item><item><widget class="QLabel" name="assumptions_text_2"><property name="textFormat"><enum>Qt::TextFormat::RichText</enum></property><property name="text"><string>&lt;html&gt;&lt;body&gt;&lt;p&gt;• The selected factor represents an estimated material relationship rather than a safety factor.&lt;/p&gt;&lt;p&gt;• Pressure results assume the differential pressure acts over the specified effective annular area. Minimum OD must exceed maximum ID; zero ID represents a solid pressure area.&lt;/p&gt;&lt;p&gt;• Friction, bending, bearing, stress concentrations and other failure modes are excluded.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
           <item>
            <spacer name="assumptions_inner_spacer">
             <property name="orientation">
              <enum>Qt::Orientation::Vertical</enum>
             </property>
             <property name="sizeType">
